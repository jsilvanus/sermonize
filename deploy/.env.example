# Sermonize deployment settings, read by `docker compose` from deploy/.env (same directory as
# docker-compose.yml). Create it with fresh secrets:
#   sh scripts/init-env.sh sermonize.example.org admin@example.org
# or copy this file to .env, fill in every empty value, and `chmod 600 .env`.
# Never commit .env. Values are used verbatim (no quotes needed, no spaces).

# --- Public name -----------------------------------------------------------------------------------
# The one domain everything is served on (https://DOMAIN/, /api/, /mcp). DNS A/AAAA -> this host.
DOMAIN=
# Contact address for Let's Encrypt expiry notices (optional, recommended).
LETSENCRYPT_EMAIL=

# --- Database --------------------------------------------------------------------------------------
# Password of the schema owner `sermonize` (superuser inside the db container; used only by the
# migrate service, the tools container and backups). Hex, so it is safe inside a postgres:// URL.
#   openssl rand -hex 32
# Only used when the db volume is first initialised: changing it later needs
#   docker compose exec db psql -U sermonize -c "\password sermonize"
POSTGRES_PASSWORD=
# Password of the least-privileged role `sermonize_app` the API connects as. The migrate service
# (re)sets it on every `docker compose up`, so it can be rotated by changing it here:
#   openssl rand -hex 32
SERMONIZE_APP_DB_PASSWORD=

# --- MCP server ------------------------------------------------------------------------------------
# Signs MCP access tokens (base64, >= 32 bytes). Rotating it invalidates access tokens (clients refresh).
#   openssl rand -base64 32
MCP_JWT_SECRET=
# AES-256-GCM key for the per-grant Sermonize API tokens in the MCP SQLite file (base64 of exactly
# 32 bytes). Losing/rotating it only means MCP users sign in again. Keep it out of backups of mcp_data.
#   openssl rand -base64 32
MCP_TOKEN_KEY=

# --- Web UI ----------------------------------------------------------------------------------------
# Signs the session and CSRF cookies (>= 32 characters). Rotating it signs everyone out.
#   openssl rand -base64 32
WEB_COOKIE_SECRET=

# --- Accounts (API) --------------------------------------------------------------------------------
# Self-registration on the web UI (POST /api/auth/register). Off by default: admins create accounts
# with sermonize-admin. Registered users get REGISTRATION_DEFAULT_ROLE (reader or contributor).
REGISTRATION_OPEN=false
REGISTRATION_DEFAULT_ROLE=reader
# Login token lifetimes in hours: web session, MCP grant (30 days), sermonize-admin login.
LOGIN_TOKEN_TTL_HOURS=12
MCP_LOGIN_TOKEN_TTL_HOURS=720
CLI_LOGIN_TOKEN_TTL_HOURS=12
# Per-client-IP limit on register and login (each separately) per window; 0 disables it.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum items per batch request (chunks, embeddings, ...). nginx allows 64 MiB request bodies on /api/.
MAX_BATCH_ITEMS=5000

# --- Operations ------------------------------------------------------------------------------------
LOG_LEVEL=info
# Image tag for the locally built images (sermonize-api:<tag>, ...), e.g. a git commit, for rollbacks.
SERMONIZE_TAG=latest
# Host ports nginx publishes (80 is needed for Let's Encrypt http-01).
HTTP_PORT=80
HTTPS_PORT=443
# Internal network of the stack and nginx's fixed address in it. The API trusts X-Forwarded-For from
# the whole subnet (nginx, web, mcp); web and mcp trust only nginx. Change both together if the
# subnet collides with another network on this host.
SERMONIZE_SUBNET=172.28.0.0/24
NGINX_BACKEND_IP=172.28.0.10
# Timeouts of one upstream API request, in milliseconds.
MCP_REQUEST_TIMEOUT_MS=15000
WEB_REQUEST_TIMEOUT_MS=10000
