# Sermonize deployment settings, read by `docker compose` from deploy/.env (next to compose.yml).
# Create it with fresh secrets for one of the two setups (docs/deployment.md):
#   sh scripts/init-env.sh host-nginx sermonize.example.org     # Setup A: host nginx, bundled database
#   sh scripts/init-env.sh traefik    sermonize.example.org     # Setup B: riksunsrk Traefik + shared Postgres
# or copy this file to .env, fill in every empty value, and `chmod 600 .env`.
# Never commit .env. Values are used verbatim (no quotes, no spaces).

# --- Setup -----------------------------------------------------------------------------------------
# Which compose files and profiles a plain `docker compose ...` in deploy/ uses.
#   Setup A:  COMPOSE_FILE=compose.yml:host-nginx/compose.host-nginx.yml
#   Setup B:  COMPOSE_FILE=compose.yml:traefik/compose.traefik.yml
# COMPOSE_PROFILES=bundled-db runs PostgreSQL in the stack (Setup A default); leave it empty for an
# external database (Setup B: the shared instance).
COMPOSE_FILE=compose.yml:host-nginx/compose.host-nginx.yml
COMPOSE_PROFILES=bundled-db

# --- Public name -----------------------------------------------------------------------------------
# The one domain everything is served on (https://DOMAIN/, /api/, /mcp).
DOMAIN=

# --- Images ----------------------------------------------------------------------------------------
# Default: built locally from the repository's Dockerfile (`docker compose build`) as sermonize-api:<tag>...
# Prebuilt images: SERMONIZE_IMAGE_PREFIX=ghcr.io/jsilvanus/sermonize and SERMONIZE_TAG=v1.2.3
# (-> ghcr.io/jsilvanus/sermonize-api:v1.2.3, ...-mcp, ...-web, ...-tools), then
# `docker compose pull && docker compose up -d --no-build`.
SERMONIZE_IMAGE_PREFIX=sermonize
SERMONIZE_TAG=latest

# --- Database --------------------------------------------------------------------------------------
# Schema owner: runs migrations (migrate service), the tools container and backups.
#   bundled:  postgres://sermonize:<POSTGRES_PASSWORD>@sermonize-db:5432/sermonize
#   shared:   postgres://sermonize_user:<password from infra's add-app.sh>@pg.shared.local:5432/sermonize_db
# Percent-encode special characters in passwords (hex passwords need none).
DATABASE_OWNER_URL=
# The API's connection. User sermonize_app (least privilege, sql/roles.sql) unless
# SERMONIZE_APP_ROLE_MODE=owner, where it is the same as DATABASE_OWNER_URL.
DATABASE_APP_URL=
# Which role the API connects as (docs/deployment.md, "Database roles and migrations"):
#   app    (default) the least-privileged sermonize_app. migrate applies its grants (roles.sql) on every
#          run and, depending on the database:
#            - creates it with the password from DATABASE_APP_URL if the owner may create roles
#              (superuser, e.g. the bundled db, or CREATEROLE), and keeps that password in sync;
#            - leaves an existing role that an administrator created (and its password) unchanged;
#            - otherwise stops and prints the one-time SQL for an administrator.
#   owner  the API connects as the schema owner (DATABASE_APP_URL = DATABASE_OWNER_URL). Weaker isolation.
# The old values managed and external still work as deprecated aliases of app.
SERMONIZE_APP_ROLE_MODE=app
# Bundled database only (profile bundled-db): password of the owner `sermonize` (a superuser inside the
# db container). Only applied when the db volume is first initialised. Hex: `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# --- MCP server ------------------------------------------------------------------------------------
# Signs MCP access tokens (base64, >= 32 bytes). Rotating it invalidates access tokens (clients refresh).
#   openssl rand -base64 32
MCP_JWT_SECRET=
# AES-256-GCM key for the per-grant Sermonize API tokens in the MCP SQLite file (base64 of exactly
# 32 bytes). Losing/rotating it only means MCP users sign in again. Keep it out of backups of mcp_data.
#   openssl rand -base64 32
MCP_TOKEN_KEY=

# --- Web UI ----------------------------------------------------------------------------------------
# Signs the session and CSRF cookies (>= 32 characters). Rotating it signs everyone out.
#   openssl rand -base64 32
WEB_COOKIE_SECRET=

# --- Accounts (API) --------------------------------------------------------------------------------
# Self-registration on the web UI (POST /api/auth/register). Off by default: admins create accounts
# with sermonize-admin. Registered users get REGISTRATION_DEFAULT_ROLE (reader or contributor).
REGISTRATION_OPEN=false
REGISTRATION_DEFAULT_ROLE=reader
# Login token lifetimes in hours: web session, MCP grant (30 days), sermonize-admin login.
LOGIN_TOKEN_TTL_HOURS=12
MCP_LOGIN_TOKEN_TTL_HOURS=720
CLI_LOGIN_TOKEN_TTL_HOURS=12
# Per-client-IP limit on register and login (each separately) per window; 0 disables it.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum items per batch request (chunks, embeddings, ...). The API accepts 64 MiB request bodies.
MAX_BATCH_ITEMS=5000

# --- Operations ------------------------------------------------------------------------------------
LOG_LEVEL=info
# Timeouts of one upstream API request, in milliseconds.
MCP_REQUEST_TIMEOUT_MS=15000
WEB_REQUEST_TIMEOUT_MS=10000
# Internal network of the stack (web/mcp -> api, api -> bundled db). The API trusts X-Forwarded-For from
# it. Change it if it collides with another network on this host.
SERMONIZE_BACKEND_SUBNET=172.28.0.0/24

# --- Setup A: host nginx ---------------------------------------------------------------------------
# Ports on 127.0.0.1 that host nginx proxies to (install.sh writes them into the nginx site).
WEB_HOST_PORT=18100
API_HOST_PORT=18101
MCP_HOST_PORT=18102
# Network the published ports sit on. Every connection from the host (nginx) arrives from its gateway,
# which web, mcp and api trust as their proxy. Change both together if the subnet collides.
SERMONIZE_EDGE_SUBNET=172.28.1.0/24
SERMONIZE_EDGE_GATEWAY=172.28.1.1

# --- Setup B: Traefik (riksunsrk infra) -------------------------------------------------------------
# External Docker networks of infra: Traefik's, and the one the shared Postgres (pg.shared.local) is on.
TRAEFIK_NETWORK=traefik-public
SHARED_NETWORK=shared_multi_network
# Subnet of TRAEFIK_NETWORK: web, mcp and api trust X-Forwarded-For from it. Find it with
#   docker network inspect traefik-public -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
TRAEFIK_TRUSTED_CIDR=
# Names in infra's Traefik static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Addresses allowed to reach /api/admin/ (comma-separated CIDRs); the default allows everyone.
ADMIN_ALLOW_CIDRS=0.0.0.0/0,::/0
