{
  "name": "sermonize-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:api": "npm run dev -w @sermonize/api",
    "dev:mcp": "npm run dev -w @sermonize/mcp",
    "dev:web": "npm run dev -w @sermonize/web",
    "migrate": "npm run migrate -w @sermonize/api",
    "cli": "npm run --silent cli -w @sermonize/api --"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
