# The server reads process.env only; export these (e.g. `set -a; . ./.env; set +a`).
PORT=3100
# 0.0.0.0 inside a container behind a reverse proxy; loopback for local development.
HOST=127.0.0.1
LOG_LEVEL=info
# Sermonize REST API (the API listens on 3000 by default). The web app never talks to PostgreSQL.
SERMONIZE_API_URL=http://127.0.0.1:3000
# Timeout of one API request, in milliseconds.
SERMONIZE_REQUEST_TIMEOUT_MS=10000
# Signs the session and CSRF cookies; at least 32 characters (openssl rand -base64 32).
WEB_COOKIE_SECRET=
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production, false otherwise.
WEB_COOKIE_SECURE=false
