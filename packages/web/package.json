{
  "name": "@sermonize/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal server-rendered Sermonize web UI (talks only to the REST API).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@sermonize/api": "0.1.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
