# The server reads process.env only; export these (e.g. `set -a; . ./.env; set +a`).
PORT=5999
# 0.0.0.0 inside a container behind a reverse proxy; loopback for local development.
HOST=127.0.0.1
LOG_LEVEL=info
# Public origin (no path): OAuth issuer; the MCP resource is <MCP_PUBLIC_URL>/mcp.
# May be the same origin as the web UI (e.g. https://example.org) when a reverse proxy routes
# /mcp, /oauth/ and /.well-known/oauth-* to this server.
MCP_PUBLIC_URL=http://localhost:5999
# Trusted reverse proxies (e.g. nginx) for X-Forwarded-For: false (default), true, or comma-separated
# addresses/CIDRs. Decides the end-user IP forwarded to the API's per-IP sign-in rate limit.
# The API's own TRUST_PROXY must list this server's address.
TRUST_PROXY=false
# base64-encoded random secret, at least 32 bytes (openssl rand -base64 32)
JWT_SECRET=
# SQLite file: OAuth grants (with encrypted upstream API tokens), authorization codes, refresh tokens.
STORAGE_PATH=./data/app.sqlite

# Sermonize REST API this server relays to (the API listens on 3000 by default).
# Users sign in with their Sermonize account: the sign-in page calls POST /auth/login on this API.
SERMONIZE_API_URL=http://127.0.0.1:3000
# AES-256-GCM key for the per-grant Sermonize API tokens stored in SQLite:
# base64 of exactly 32 random bytes (openssl rand -base64 32). Losing it only means users sign in again.
SERMONIZE_TOKEN_KEY=
# Timeout of one upstream API request, in milliseconds.
SERMONIZE_REQUEST_TIMEOUT_MS=15000
