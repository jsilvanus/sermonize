{
  "name": "@sermonize/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sermonize REST API (Fastify + PostgreSQL/pgvector).",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./*": {
      "@sermonize/source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/cli.ts migrate",
    "cli": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
