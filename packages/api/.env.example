# Application database (the role should be sermonize_app in production; see sql/roles.sql)
DATABASE_URL=postgres://sermonize:sermonize@localhost:5432/sermonize
# Test database: its public and private schemas are DROPPED and recreated by `npm test`
TEST_DATABASE_URL=postgres://sermonize:sermonize@localhost:5432/sermonize_test
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
MAX_BATCH_ITEMS=5000
