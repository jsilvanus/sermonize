# Application database (the role should be sermonize_app in production; see sql/roles.sql)
DATABASE_URL=postgres://sermonize:sermonize@localhost:5432/sermonize
# Test database: its public and private schemas are DROPPED and recreated by `npm test`
TEST_DATABASE_URL=postgres://sermonize:sermonize@localhost:5432/sermonize_test
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
MAX_BATCH_ITEMS=5000
# Trusted reverse proxies for X-Forwarded-For (decides the client IP of the auth rate limit):
# false (default), true, or comma-separated addresses/CIDRs. List every host that calls /auth/* on behalf of
# end users: @sermonize/web and @sermonize/mcp (both forward the end user's IP) and nginx,
# e.g. 127.0.0.1 when they all run on this host, or the Docker network's gateway/subnet.
TRUST_PROXY=false
# Public path prefix when a reverse proxy publishes the API under it and strips it (nginx: /api/ -> /),
# e.g. /api. Only affects the OpenAPI document's `servers` and the Swagger UI asset URLs (/api/docs).
# Unset or empty: served at the root.
PUBLIC_BASE_PATH=

# Self-service password accounts (POST /auth/register, /auth/login; used by @sermonize/web and @sermonize/mcp)
REGISTRATION_OPEN=false
# Role of self-registered users: reader or contributor (anything else refuses to start)
REGISTRATION_DEFAULT_ROLE=reader
# Lifetime of login tokens: web sessions (client "web", the default) and MCP OAuth grants (client "mcp", 30 days)
LOGIN_TOKEN_TTL_HOURS=12
MCP_LOGIN_TOKEN_TTL_HOURS=720
# Lifetime of `sermonize-admin login` tokens (client "cli")
CLI_LOGIN_TOKEN_TTL_HOURS=12
# Per-IP limit on register + login (each route separately), in-memory; 0 disables it
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
